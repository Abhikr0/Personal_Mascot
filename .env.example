# Friday / Sylphya AI Mascot Configuration

# Speech recognition language (BCP-47 tag, e.g. en-IN, en-US, hi-IN)
LANGUAGE=en-IN

# Groq API Key (Fast LLM inference)
GROQ_API_KEY=your_groq_api_key_here

# Mistral API Key (Reasoning / LangGraph Agent)
MISTRAL_API_KEY=your_mistral_api_key_here

# Google Gemini API Key (Multimodal & Assistant operations)
GEMINI_API_KEY=your_gemini_api_key_here

# Hermes Local Agent Brain (OpenAI-compatible gateway at http://localhost:8642)
HERMES_ENABLED=true
HERMES_API_BASE=http://127.0.0.1:8642/v1
HERMES_API_KEY=your_hermes_api_key_here
HERMES_MODEL=hermes-agent
